# Environment variables for Graph Node
# This file will be created during deployment

# PostgreSQL Connection (DigitalOcean Managed Database)
POSTGRES_HOST=your-db-host.db.ondigitalocean.com
POSTGRES_PORT=25060
POSTGRES_USER=doadmin
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=defaultdb

# Optional RPC overrides for multi-chain indexing
KAVA_RPC_URL=https://lb.nodies.app/v1/your-kava-key
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# These will be automatically set during deployment
